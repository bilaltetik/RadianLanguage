// Fibonacci — özyinelemeli ve döngülü iki gerçekleme.

fib (n:i32) -> i32 {
    if n < 2 { return n; }
    fib(n - 1) + fib(n - 2);
}

fib_dongu (n:i32) -> i32 {
    a = 0;
    b = 1;
    i = 0;
    while i < n {
        yeni = a + b;
        a = b;
        b = yeni;
        i += 1;
    }
    a;
}

main () -> i32 {
    print("özyinelemeli:");
    for i in range(10) {
        write(fib(i), " ");
    }
    print("");

    print("döngülü:");
    for i in range(10) {
        write(fib_dongu(i), " ");
    }
    print("");

    // İki gerçekleme aynı sonucu vermeli
    for i in range(15) {
        assert(fib(i) == fib_dongu(i), "fib gerçeklemeleri ayrıştı");
    }
    print("doğrulandı");
    0;
}
